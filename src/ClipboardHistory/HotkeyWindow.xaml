<Window x:Class="ClipboardHistory.HotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="단축키 변경 - WinClips"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        InputMethod.IsInputMethodEnabled="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}">

  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Focusable" Value="False" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="22,18" Width="380">
    <TextBlock TextWrapping="Wrap">
      기록 목록을 여는 새 단축키를 그대로 눌러 주세요.
    </TextBlock>
    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SubtleFg}" FontSize="12">
      Ctrl, Alt, Shift 중 하나 이상 + 키 하나 (예: Ctrl+Shift+V, Ctrl+Alt+F8). Enter 저장, Esc 취소.
    </TextBlock>

    <Border Margin="0,14,0,0" Padding="0,14" CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource Accent}">
      <TextBlock x:Name="Display" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" />
    </Border>

    <TextBlock x:Name="Current" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource SubtleFg}" />
    <TextBlock x:Name="Status" Margin="0,4,0,0" MinHeight="18" TextWrapping="Wrap" FontSize="12"
               Foreground="{DynamicResource Error}" />

    <DockPanel Margin="0,14,0,0" LastChildFill="False">
      <Button x:Name="DefaultButton" DockPanel.Dock="Left" Content="기본값" Click="Default_Click" />
      <Button DockPanel.Dock="Right" Content="취소" Margin="8,0,0,0" Click="Cancel_Click" />
      <Button DockPanel.Dock="Right" Content="저장" Click="Save_Click" />
    </DockPanel>
  </StackPanel>
</Window>
