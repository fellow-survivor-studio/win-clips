<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- WPF and WinForms both define Application, MessageBox, ...; keep usings explicit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ClipboardHistory</RootNamespace>
    <AssemblyName>WinClips</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.1</Version>
    <Product>WinClips</Product>
    <Company>fellow-survivor-studio</Company>
    <Copyright>Copyright (c) 2026 fellow-survivor-studio</Copyright>
    <Description>Clipboard history manager for Windows</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF app: DPI awareness belongs in app.manifest; the WinForms-only hint does not apply. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipboardHistory.Core\ClipboardHistory.Core.csproj" />
  </ItemGroup>

</Project>
