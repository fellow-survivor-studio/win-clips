<Window x:Class="ClipboardHistory.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinClips"
        Width="480" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        Foreground="{DynamicResource Fg}">

  <Window.Resources>
    <Style x:Key="ItemStyle" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,5" Margin="0,1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBg}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="MinWidth" Value="8" />
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <!-- Shadow is a separate layer so the effect does not blur the text above it. -->
    <Border CornerRadius="10" Background="{DynamicResource Bg}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.28" />
      </Border.Effect>
    </Border>

    <Border CornerRadius="10" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Outline}" BorderThickness="1">
      <Grid Margin="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- search -->
        <Border Grid.Row="0" CornerRadius="6" BorderThickness="1" Padding="8,0"
                Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource Outline}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                       VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SubtleFg}" />
            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="검색" VerticalAlignment="Center"
                       Margin="2,0,0,0" Foreground="{DynamicResource SubtleFg}" IsHitTestVisible="False" />
            <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                     Padding="0,7" FontSize="14" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged" />
          </Grid>
        </Border>

        <!-- list -->
        <ListBox x:Name="List" Grid.Row="1" Margin="0,8,0,0"
                 Background="Transparent" BorderThickness="0" Focusable="False"
                 ItemContainerStyle="{StaticResource ItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                 SelectionMode="Single" SelectionChanged="List_SelectionChanged"
                 PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                 PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                 MouseMove="List_MouseMove">
          <ListBox.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
          </ListBox.Resources>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource SubtleFg}" />
                <TextBlock Grid.Column="1" Text="{Binding Preview}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent}" Visibility="{Binding PinVisibility}" />
                <TextBlock Grid.Column="3" Text="{Binding Shortcut}" FontSize="11" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource SubtleFg}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="기록이 없습니다" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="{DynamicResource SubtleFg}" Visibility="Collapsed" />

        <!-- preview -->
        <Border Grid.Row="2" Height="170" Margin="0,8,0,0" CornerRadius="6" Padding="10,8"
                Background="{DynamicResource PreviewBg}">
          <Grid>
            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Fg}" />
            <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly"
                   RenderOptions.BitmapScalingMode="HighQuality" />
          </Grid>
        </Border>

        <!-- footer -->
        <Grid Grid.Row="3" Margin="2,8,2,0">
          <TextBlock x:Name="Footer" FontSize="11" Foreground="{DynamicResource SubtleFg}"
                     TextTrimming="CharacterEllipsis" Margin="0,0,60,0" />
          <TextBlock x:Name="CountText" FontSize="11" Foreground="{DynamicResource SubtleFg}" HorizontalAlignment="Right" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
